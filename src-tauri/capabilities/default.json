{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "allow-get-vault-status",
    "allow-create-vault",
    "allow-unlock-with-password",
    "allow-unlock-with-recovery-key",
    "allow-lock-vault",
    "allow-report-activity",
    "allow-list-folders",
    "allow-create-folder",
    "allow-update-folder",
    "allow-delete-folder",
    "allow-list-items",
    "allow-get-item",
    "allow-create-item",
    "allow-reveal-item-field",
    "allow-copy-item-field",
    "allow-update-item",
    "allow-delete-item",
    "allow-delete-items",
    "allow-move-items",
    "allow-import-file",
    "allow-export-file",
    "allow-change-password",
    "allow-create-new-recovery-key"
  ]
}
