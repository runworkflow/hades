{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-set-content-protected",
    "core:window:allow-internal-toggle-maximize",
    "allow-get-vault-status",
    "allow-create-vault",
    "allow-unlock-with-password",
    "allow-unlock-with-recovery-key",
    "allow-lock-vault",
    "allow-report-activity",
    "allow-list-folders",
    "allow-create-folder",
    "allow-update-folder",
    "allow-delete-folder",
    "allow-list-items",
    "allow-get-item",
    "allow-create-item",
    "allow-reveal-item-field",
    "allow-copy-item-field",
    "allow-update-item",
    "allow-delete-item",
    "allow-delete-items",
    "allow-move-items",
    "allow-import-file",
    "allow-export-file",
    "allow-change-password",
    "allow-create-new-recovery-key",
    "allow-get-biometric-status",
    "allow-enable-biometric-unlock",
    "allow-disable-biometric-unlock",
    "allow-unlock-with-biometrics"
  ]
}
